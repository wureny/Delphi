# Delphi prototype — no secrets are required.
#
# The public demo runs entirely in deterministic fixture mode and must
# complete without any of the variables below. They exist only to document
# the optional live-model adapter boundary. Never commit real values.

# --- Optional live-model adapter (server-side only; hidden when unset) ---
# DELPHI_ANALYSIS_MODE=fixture
# DELPHI_LIVE_ADAPTER_ENABLED=false
# DELPHI_LIVE_MODEL_PROVIDER=
# DELPHI_LIVE_MODEL_NAME=
# DELPHI_LIVE_MODEL_API_KEY=

# --- Optional graph capability (read-only in-memory projection by default) ---
# DELPHI_GRAPH_MODE=projection

# --- Website contact CTA (hidden when missing or invalid) ---
NEXT_PUBLIC_CONTACT_EMAIL=alixwu2004@gmail.com
